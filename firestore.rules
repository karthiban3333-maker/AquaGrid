rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profiles Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false; // Prevent accidental deletion of profile records
    }

    // Springs Registry Collection
    match /springs/{springId} {
      allow read: if true; // Public read for springs map & registry
      allow write: if isSignedIn(); // Authenticated facilitators/officers can submit or update spring records
    }

    // Field Observations Collection
    match /observations/{observationId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // Issues & Visitor Reports Collection
    match /spring_issues/{issueId} {
      allow read: if true;
      allow create: if true; // Allow visitor issue reporting
      allow update, delete: if isSignedIn();
    }
  }
}
